# Variables d'environnement — COPIER EN .env ET REMPLIR
# NE JAMAIS COMMITTER LE FICHIER .env

# ---- LLM Providers (renseigner AU MOINS UN) ----
ANTHROPIC_API_KEY=sk-ant-...           # https://console.anthropic.com
DEEPSEEK_API_KEY=sk-...                # https://platform.deepseek.com  ← recommandé
GITHUB_TOKEN=ghp_...                   # https://github.com/settings/tokens (scope: models:read)
OPENAI_API_KEY=sk-...                  # optionnel
XAI_API_KEY=xai-...                    # optionnel Grok
OLLAMA_BASE_URL=http://localhost:11434 # optionnel Ollama local

# ---- Web Crawling ----
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
SERPAPI_API_KEY=...           # fallback

# ---- Exchange ----
BINANCE_API_KEY=...
BINANCE_API_SECRET=...
BINANCE_TESTNET=true          # toujours true pour paper trading

# ---- News ----
NEWSAPI_KEY=...

# ---- Notifications (optionnel) ----
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---- Admin Interface ----
ADMIN_PASSWORD=changeme       # sera hashé en SHA-256 au premier lancement

# ---- On-Chain Data ----
# Sources gratuites SANS clé : blockchain.com + mempool.space + CoinMetrics Community
# CryptoQuant free tier : 50 req/jour, résolution 1j, 7j historique, usage personnel uniquement
# Le résultat est mis en cache 24h (storage/cryptoquant_cache.json) — 1 req/jour en pratique
CRYPTOQUANT_API_KEY=           # inscription : https://cryptoquant.com/settings/api
# Glassnode : plan PAYANT requis (Advanced ~$29/mois) — plan studio = pas d'API
# GLASSNODE_API_KEY=

# ---- App ----
LOG_LEVEL=INFO
ENVIRONMENT=development       # development | production
