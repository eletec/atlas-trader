# ============================================================
# .gitignore — Atlas Trader
# ============================================================

# Secrets — NE JAMAIS COMMITTER
.env
.env.local
.env.*.local

# Comptes utilisateurs (contient mots de passe hashés — ne pas versionner)
config/users.yaml

# Clés API et secrets locaux (Twelve Data, etc.)
config/secrets.yaml

# Bases de données locales (SQLite + journaux WAL)
storage/*.db
storage/*.db-shm
storage/*.db-wal

# Données runtime : dumps SQLite, résultats de backtest, configs générées.
# Le runtime de production vit dans le volume Docker « v4_storage » (/app/data),
# ces dossiers ne sont que des résidus de lancements locaux.
data/
v4_data/
*.db
*.db-shm
*.db-wal
backtest_results.json
grid_search_results.yaml

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Environnements virtuels
.venv/
venv/
env/

# Build / distribution
*.egg-info/
dist/
build/
*.egg
*.whl

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Images générées
images/
logo_b64.txt
logo_block.txt

# Fichiers de travail temporaires
fix_css.py

# Docs opérationnelles / prompts d'audit — ne pas publier
OPS.md
AUDIT_V7_PROMPT.md
fix_tabs.py
gen_logo.py
patch_icons.py
patch_logo.py
patch_redesign.py
verify_patch.py
CDC.txt

# Dossiers non utilisés
claude_agentic/
ATLAS_CRITICAL_ANALYSIS_PROMPT.md
