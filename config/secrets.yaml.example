# Atlas Trader V7 — Secrets (template)
# Copier ce fichier en secrets.yaml et remplir les valeurs
# secrets.yaml est dans .gitignore — ne jamais commiter de clés réelles

# ── LLM / IA ─────────────────────────────────────────────────────────────
llm:
  # DeepSeek (primary — via litellm)
  deepseek_api_key: "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  # OpenAI (fallback)
  openai_api_key: ""
  # Anthropic (fallback)
  anthropic_api_key: ""

# ── Exchange API (testnet) ───────────────────────────────────────────────
exchange:
  binance:
    api_key: ""
    secret: ""
  bybit:
    api_key: ""
    secret: ""

# ── Notifications ─────────────────────────────────────────────────────────
telegram:
  bot_token: ""
  chat_id: ""

discord:
  webhook_url: ""
