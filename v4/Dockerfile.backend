# Atlas Trader V4 — Backend (FastAPI + DAG Executor)
FROM python:3.11-slim

WORKDIR /app

# Dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# Dépendances Python V4 (subset de requirements.txt + ajouts V4)
COPY v4/requirements.backend.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.backend.txt

# V4 source + wrapped V3 modules (mounted as a volume in dev)
COPY . /app/src

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
# Use the system allocator (glibc) instead of pymalloc — avoids fragmentation
# pymalloc keeps allocated arenas (128-256 MB each) even when empty
ENV PYTHONMALLOC=malloc

EXPOSE 8000

CMD ["uvicorn", "v4.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
